#!/bin/sh

echo "===> Checking code formatting..."
./gradlew spotlessCheck

if [ $? -ne 0 ]; then
    echo "Formatting errors found! Run './gradlew spotlessApply', stage changes, and try again."
    exit 1
fi

echo "===> Running project checks..."
./gradlew check

if [ $? -ne 0 ]; then
    echo "Build or tests failed! Fix the errors above and try committing again."
    exit 1
fi

echo "Pre-commit checks passed successfully!"